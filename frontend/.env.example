# true (по умолчанию) — данные берутся из src/api/mocks.ts
# false — данные запрашиваются у FastAPI
VITE_USE_MOCKS=true

# Адрес API. Пусто = тот же домен (в dev работает прокси /api -> localhost:8000)
VITE_API_URL=

# Только dev и только без бэкенда: вход в админку (/admin).
# С FastAPI логин и пароль проверяет сервер.
VITE_ADMIN_MOCK_USER=admin
VITE_ADMIN_MOCK_PASSWORD=admin
